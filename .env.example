# Discord Configuration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# NVD API Configuration
# STRONGLY RECOMMENDED: Get a free API key for 10x faster rate limits (50 req/30s vs 5 req/30s)
# Request your free API key at: https://nvd.nist.gov/developers/request-an-api-key
# Without a key, the bot will be much slower and may timeout on large batches
NVD_API_KEY=

# Optional: Override default settings
# KEV_CHECK_HOURS=24
# NVD_REQUEST_DELAY_SECONDS=6.0  # 6.0 without API key, 0.6 with API key (auto-validated)
# MAX_DISCORD_EMBEDS_PER_MESSAGE=10
